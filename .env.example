# Copy to .env and fill in. Used by docker-compose.yml.

# Your domain, without https:// (point its A record at this server first).
DOMAIN=pdfwise.example.com

# Optional: Search Console / Bing verification (the content="…" value of their HTML tag).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Optional analytics (cookie-free). Set one.
VITE_PLAUSIBLE_DOMAIN=
VITE_UMAMI_WEBSITE_ID=

# true adds LibreOffice (best Office fidelity, binary .ppt). About 600 MB larger; give it 3 GB of RAM.
INCLUDE_LIBREOFFICE=false
PDFWISE_MEMORY=2g

# Limits
RATE_LIMIT_PER_MIN=30
MAX_UPLOAD_MB=100

# Leave empty for a public site. user:password puts the whole site behind a login.
BASIC_AUTH=

# Proxy setup. Caddy only: keep TRUST_PROXY=1.
# Cloudflare (orange cloud) in front of Caddy: TRUST_PROXY=2 and TRUSTED_PROXIES set to Cloudflare's
# ranges, so rate limits see visitors' real IPs. Check the current list at https://www.cloudflare.com/ips/
TRUST_PROXY=1
