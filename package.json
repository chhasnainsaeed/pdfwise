{
  "name": "pdfwise",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs && node scripts/pwa.mjs",
    "preview": "vite preview",
    "server": "node server/index.js",
    "start": "npm run build && node server/index.js",
    "test": "node --test",
    "new-tool": "node scripts/new-tool.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "eslint . && prettier --check . && node --test",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/dancing-script": "5.3.0",
    "@fontsource/homemade-apple": "5.3.0",
    "@neslinesli93/qpdf-wasm": "^0.3.0",
    "@xmldom/xmldom": "^0.9.12",
    "docx": "^9.15.1",
    "docx-preview": "^0.4.1",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.460.0",
    "mammoth": "^1.13.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "puppeteer-core": "^25.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "tesseract.js": "^5.1.1",
    "three": "^0.187.0",
    "word-extractor": "^1.0.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "3.9.10",
    "vite": "^7.3.7"
  }
}
